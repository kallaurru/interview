#!/bin/bash
# читайте stdin, пишите ответ в stdout

read -r T            # первая строка stdin — порог; остальное уйдёт awk
awk -v t="$T" '
NF == 3 {                            # защита от пустых и битых строк
  total[$1]++                        # $1 — path: счётчик всех запросов
  if ($3 + 0 >= t + 0) slow[$1]++    # $3 — duration_ms; +0 приводит к числу
}
END {
  for (p in total) {
    s = (p in slow) ? slow[p] : 0
    printf "%s %d %d %d\n", p, total[p], s, int(s * 100 / total[p])
  }
}' | LC_ALL=C sort